<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <!-- THIS FILE EXISTS FOR ONE REASON: Maven Central through qits-platform-mirror's pull-through
         cache. It carries no platform-registry mirror, unlike the lib repositories' copies of it,
         because this pom is PARENTLESS and depends on no qits artifact — nothing here declares a
         repository the platform serves, so there would be nothing for such a mirror to match. If
         this repository ever takes a qits dependency, the registry mirror comes back with it.

         Read only by the QA pipeline in .config/qits (`-s .qits-maven-settings.xml`), which runs
         inside a step container. A developer's build needs none of it and passes no -s at all.

         An exact repository-id match is what wins over Maven's external:http:* blocker, which is
         why the mirror below is scoped to the one repository the profile declares rather than to
         `*` — so while QITS_MAVEN_CENTRAL_URL is unset or empty, nothing declares qits-central,
         this entry matches nothing, and the unexpanded URL is never dialled. -->
    <mirror>
      <id>qits-central-proxy</id>
      <mirrorOf>qits-central</mirrorOf>
      <url>${env.QITS_MAVEN_CENTRAL_URL}</url>
    </mirror>
  </mirrors>
  <profiles>
    <!-- Active only while QITS_MAVEN_CENTRAL_URL is NON-EMPTY — measured on Maven 3.9: an empty
         environment value does not activate a property-presence profile, so an injected-empty
         variable is the off switch and no call site needs a guard. Central itself is re-declared
         DISABLED, because repository ordering consults the stock central first and the mirror above
         would never see a request; qits-central takes its place and the mirror reroutes it whole to
         the pull-through. Unset means stock Maven Central, exactly as before this profile existed. -->
    <profile>
      <id>qits-central-proxy</id>
      <activation>
        <property><name>env.QITS_MAVEN_CENTRAL_URL</name></property>
      </activation>
      <repositories>
        <repository>
          <id>central</id>
          <url>https://repo1.maven.org/maven2</url>
          <releases><enabled>false</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
          <id>qits-central</id>
          <url>https://repo1.maven.org/maven2</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>central</id>
          <url>https://repo1.maven.org/maven2</url>
          <releases><enabled>false</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
        <pluginRepository>
          <id>qits-central</id>
          <url>https://repo1.maven.org/maven2</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
</settings>
