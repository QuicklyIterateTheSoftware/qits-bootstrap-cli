# qits-cli-bootstrap — copy to .env and edit. Quarkus reads .env from the working directory, so
# every name here is also an ordinary environment variable: what is in the file and what is in the
# environment mean the same thing, and the environment wins.
#
# Every knob below is the one qits-local-up.sh read, under the same name. The defaults are the
# script's defaults; a line you do not need is a line you can delete.

# --- where the sources are ---------------------------------------------------------------------

# OPTIONAL. The wrapper repository (qits-qits, or a worktree of it) whose submodule checkouts this
# bootstrap clones from. It is also where the generated docker-compose.qits.yml and
# .qits-bootstrap.env land.
#
# Unset is the ordinary case: this CLI lives at cli/qits-cli-bootstrap INSIDE the wrapper, so it
# finds it by walking up from the working directory to the first .gitmodules naming the qits
# submodules. Preflight prints which of the two happened, and says both ways out when neither
# worked. Set this to run from outside the checkout entirely.
#QITS_WRAPPER_DIR=/home/you/code/qits-qits

# Where those clones go. Seed builds write a placeholder client into the tree and may commit a
# pipeline config, so the sources are a copy and never your own checkout.
#QITS_SRC=.qits-bootstrap-src

# Used only for a repository that has no local checkout under QITS_WRAPPER_DIR.
#QITS_ORG_URL=https://github.com/QuicklyIterateTheSoftware

# --- ports -------------------------------------------------------------------------------------

# The host's ONE published port, bound by qits-platform-edge. Everything the CLI reads over it —
# qits-ci, qits-deployments, the git host — goes edge -> the environment's gateway -> the service.
# qits-gateway publishes no port of its own any more.
#QITS_PORT=8080

# The host port qits-platform-artifacts publishes for the DOCKER DAEMON's pulls and pushes.
# localhost registries are HTTP-allowed by docker without daemon config, which is the whole trick —
# and it is this CLI's own door to the registry, the artifacts API and the git host.
#QITS_REGISTRY_PORT=8081

# --- what to do --------------------------------------------------------------------------------

# 1 = the seed images and the ci-daemon binary exist already; skip to compose and the pushes. The
# recorded digest in .qits-bootstrap.env is then required.
#QITS_SKIP_BUILD=0

# The environment this platform runs, and the ONE deploy ref is its branch, environment/<name>.
# The four platform services (qits-platform-edge, qits-platform-idp, qits-platform-artifacts,
# qits-platform-docs) deploy from that same ref — there is one instance of each and it joins every
# environment's networks. main is the trunk everywhere and deploys nothing.
#
# IT IS ALSO THE PLATFORM ENVIRONMENT — the one tier whose branch deploys the platform plane. The
# bootstrap creates it with that flag, and the deployer ships a platform service from this branch
# and from no other tier's.
#
# THIS NAME IS INSIDE EVERYTHING. An environment service answers to <name>-qits-<app> on the
# network, its deployed container is qits-pd-<name>-qits-<app>-<id8>, and its idp client id is
# <name>-qits-<app>. Changing it after a bootstrap is a new platform, not a rename — and the
# `environment` phase REFUSES rather than renaming, naming what already stands here.
#
# `--platform-env <name>` on the command line is the same knob for one run.
#QITS_ENV_NAME=prod

# --- waiting -----------------------------------------------------------------------------------
# Seconds. Every one of these is shown on screen while it counts down.

# Per application deployment: a cold GraalVM native build plus a health-gated cutover.
#QITS_DEPLOY_TIMEOUT=3600
# Per replayed release run.
#QITS_RELEASE_TIMEOUT=1800
# Per seed service coming up.
#QITS_HEALTH_TIMEOUT=120
# How often the deployment and run polls ask again.
#QITS_POLL_INTERVAL=10

# --- credentials -------------------------------------------------------------------------------

# The git host's push token: what `-o qits.token=<value>` must equal to push a protected default
# branch. NOT a secret — it is the documented escape hatch, and it must be the same across reruns.
#QITS_PUSH_TOKEN=local-dev

# 1 = machine-token enforcement ON for ci, deployments and platform-artifacts. Enforcement that
# only ever runs in production is enforcement nobody has tested, so it is on by default.
#QITS_MACHINE_AUTH=1

# Pin one idp client's secret instead of letting the bootstrap generate it. Without these, the
# first run generates them and records them in .qits-bootstrap.env, and later runs keep what is
# recorded — a rotated secret locks every already-deployed service out.
#
# A CLIENT ID IS A WIRE ALIAS, so three of these four carry the environment name: the ids below
# are what QITS_ENV_NAME=prod produces. Set another environment name and every key moves with it.
#
# There is no qits-deployments entry and there will not be: that service mints nothing, so it holds
# no client and no secret — only an audience its callers are granted. There is no qits-cd entry
# either: every id moved on 2026-08-08, so no key here is one a pre-rename platform would know.
#QITS_IDP_CLIENT_PROD_QITS_CI_SECRET=
#QITS_IDP_CLIENT_QITS_PLATFORM_ARTIFACTS_SECRET=
#QITS_IDP_CLIENT_PROD_QITS_WORKSPACES_SECRET=
#QITS_IDP_CLIENT_PROD_QITS_GATEWAY_SECRET=

# --- the display -------------------------------------------------------------------------------

# 0 = never draw the live display, even on a terminal that could take it. `--no-tui` does the same
# for one run. A pipe or a dumb TERM falls back on its own.
#QITS_TUI=1

# Lines of the running step's output kept in memory for the body region, and for the browser view.
#QITS_TAIL_LINES=2000

# The browser view: the same run, live, at http://localhost:8480. It is printed when the run
# starts. 0 = off entirely, and then no port is bound at all.
#QITS_WEB=1

# 8480 because 8080 is the edge and 8081 is the artifacts service. A port already in use STOPS the CLI
# before the boot starts, so a second run at the same time needs this moved, or QITS_WEB=0.
#QITS_WEB_PORT=8480

# What it binds. 0.0.0.0 puts the view on whatever network this machine is joined to — which is
# what watching a bootstrap from another machine needs, and a decision to make on purpose.
# 0.0.0.0 by default (WSL2: the Windows-side browser cannot reliably reach a WSL-loopback
# bind). Set 127.0.0.1 to keep the view off the LAN.
#QITS_WEB_HOST=0.0.0.0

# The full log of every command, in the working directory.
#QITS_LOG_FILE=qits-bootstrap-cli.log

# qits-platform-idp publishes no host port on purpose, so the CLI reaches it with one throwaway curl
# container on qits-net. The reference is direct (docker.io) because a cold start cannot pull
# through the mirror it is starting.
#QITS_CURL_IMAGE=curlimages/curl:latest
