{
  "name": "qits-projects-frontend",
  "version": "2026.1105.95912",
  "private": true,
  "description": "The projects service's frontend: an Angular application that consumes @qits/ui-components from qits' own npm registry. It ships no image — qits-projects serves it via Quinoa at the root of its own host.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuicklyIterateTheSoftware/qits-spa-projects.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@qits/ui-components": "^2026.1103.133955",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "atrament": "^5.1.0",
    "marked": "^18.0.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.5.0",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@pact-foundation/pact": "17.1.4",
    "@qits/angular": "2026.1103.125108",
    "@qits/ci-golden-masters": "2026.1102.180015",
    "@qits/edge-golden-masters": "2026.1010.182320",
    "@qits/githost-golden-masters": "2026.1020.204038",
    "@qits/projects-golden-masters": "2026.1105.84836",
    "@types/node": "^20.19.43",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.8.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.0.8"
  }
}
