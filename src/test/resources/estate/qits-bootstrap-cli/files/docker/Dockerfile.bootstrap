# The one-shot bootstrap payload is deliberately a JVM image.  It has no latency-sensitive request
# path and keeps recovery headroom for the capped native seed image builds it orchestrates.
#
# A native image can still be produced explicitly from this checkout for installations that need
# one; it is not the cold-recovery payload's dependency.
FROM maven:3.9-eclipse-temurin-25 AS build

WORKDIR /src

# Keep this list in lockstep with PayloadImage.CONTENT.  Tests are deliberately absent: the image
# is a recovery vehicle and the source test suite is run before it is promoted.
COPY pom.xml ./
COPY src/main/ src/main/

# Use the Maven binary baked into the builder rather than mvnw.  A recovery host may have a broken
# wrapper distribution cache, whereas this tagged builder is the independently validated path.
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -ntp package -DskipTests \
        -Dquarkus.build.skip=false \
        -Dquarkus.package.jar.enabled=true \
        -Dquarkus.package.jar.type=fast-jar

FROM eclipse-temurin:25-jre-alpine

# The JVM is the only addition compared with the former static payload.  Everything the CLI shells
# remains available in the runtime image, so its capability and mount model stay unchanged.
#
# buildx is kept for ONE job now: sweeping the qits-bootstrap-builder* builders a host may still
# carry from before the builds moved to qits-buildkitd.  Nothing here builds with it, and buildctl
# is not installed at all — the client runs out of the buildkit image itself.
RUN apk add --no-cache \
        ca-certificates \
        docker-cli \
        docker-cli-buildx \
        docker-cli-compose \
        git

WORKDIR /work

COPY --from=build /src/target/quarkus-app/ /opt/qits/

ENTRYPOINT ["java", "-jar", "/opt/qits/quarkus-run.jar"]
