# The bootstrap, as an image, so the cold boot can run on the platform's docker network
# instead of on the host. Build it from the repository root:
#
#     docker build -f docker/Dockerfile.bootstrap -t qits-bootstrap:<tag> .
#
# The CLI builds and runs this itself when it is started outside a container, and tags it by the
# content of what the build reads, so a rerun with unchanged sources rebuilds nothing.
#
# It ships the UBER-JAR, not the native binary, and that is not a preference. This host is
# glibc 2.42. A binary linked here will not start on Debian stable (2.36), on Ubuntu 24.04
# (2.39), or on any musl image at all, so a host-built binary copied in is a broken image
# that builds cleanly. The jar carries no libc of its own and runs on the JRE below it.
#
# THE JAR IS BUILT HERE, in the first stage, and that is what makes this image cold-start
# capable. Copying a jar out of target/ would mean the image could only be built on a machine
# that had just run maven — and the binary people run is the NATIVE one, which leaves no jar
# beside it, so the failure would land on exactly the machine the bootstrap is for. Building it
# in the image also removes the "did you run mvn first" question entirely: the only input is
# the checkout.
FROM maven:3.9-eclipse-temurin-25 AS build

WORKDIR /src

# Only what the build reads, and the CLI hashes the same four paths to tag the image. Copying
# the whole context instead would make every log file and every editor scratch file a rebuild.
COPY .mvn/ .mvn/
COPY pom.xml ./
COPY src/main/ src/main/

# The maven repository is a BuildKit cache mount, not a layer: it survives between builds on this
# daemon, so a source change re-resolves nothing. Without it every rebuild is a cold download of
# the whole Quarkus platform, which is minutes, on a loop people run often.
#
# -DskipTests because the tests are the `./mvnw clean verify` gate on the host, not a step of the
# image build; src/test is not even copied above.
RUN --mount=type=cache,target=/root/.m2/repository \
    mvn -B -ntp package -DskipTests

# The base is upstream on purpose. This image has to build on a machine that has never seen
# the platform, and every platform image — ci-base included — is built BY this bootstrap.
# Basing it on one of those makes the cold boot need the thing it exists to create.
#
# eclipse-temurin:25-jre-alpine: the jar targets release 25, and alpine keeps the layer small.
# musl is safe here for the reason above — nothing in the image is linked against this host.
# alpine:3.23 with its own openjdk25-jre-headless was measured against this and came out 34 MB
# LARGER, so the obvious saving is not one. Most of the image is the docker CLI trio; the way
# to make it small is a jlink or native stage, not another JRE package.
FROM eclipse-temurin:25-jre-alpine

# What the CLI shells, and nothing else:
#
#   docker-cli            eleven of its commands are `docker ...`
#   docker-cli-buildx     the BUILDER IS CHOSEN BY THE CLIENT. A client without buildx does not
#                         fail — it quietly falls back to the legacy builder, which reads flags
#                         differently. qits-deployments already carries a scar from that:
#                         `--network qits-net` on a build only worked because an old client fell
#                         back to it. Shipping buildx is what keeps this image honest.
#   docker-cli-compose    SeedPhases refuses to boot without it ("docker compose plugin missing"),
#                         and the seed plane is brought up by `docker compose -p qits`
#   git                   clones and pushes are shelled, not a Java git library
#   ca-certificates       the platform's HTTP is called over TLS
#
# The versions are left to the branch: alpine drops old package versions from its index, so a
# pinned version is a cold build that fails on the day it is aged out.
#
# Not listed because busybox already has them: sh, stty and tty, which JLine's exec provider
# shells for every terminal (it is pinned to exec because the jni and ffm providers cannot be
# native-imaged), and stat, which reads the docker socket's group.
RUN apk add --no-cache \
        ca-certificates \
        docker-cli \
        docker-cli-buildx \
        docker-cli-compose \
        git

# A fallback only. The launcher sets the working directory to the one it was started in, which is
# also a mount, so the run's log and clones land on the host where the next run can find them.
WORKDIR /work

# Copied by glob so the CalVer version in the name is not repeated here, where it would go stale.
COPY --from=build /src/target/qits-cli-bootstrap-*-runner.jar /opt/qits/bootstrap.jar

ENTRYPOINT ["java", "-jar", "/opt/qits/bootstrap.jar"]
