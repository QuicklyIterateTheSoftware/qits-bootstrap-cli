<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- qits-cli-bootstrap: the platform's cold bootstrap as a Quarkus command-mode CLI.
         It replaces the wrapper repo's qits-local-up.sh and its 50-minute silences with a
         live-progress terminal UI.

         PARENTLESS on purpose, like every other qits repo: a clone of this repo alone must build
         with no monorepo and no parent to inherit from. Versions that must stay in step with the
         platform (Quarkus, the JDK release) are duplicated here deliberately.

         Two build forms. `./mvnw package -Dnative -DskipTests` makes the binary people run;
         `./mvnw clean verify` makes the uber-jar and is the loop while working on the CLI. -->
    <groupId>eu.wohlben.qits</groupId>
    <artifactId>qits-cli-bootstrap</artifactId>
    <version>2026.807.193132</version>
    <name>qits-cli-bootstrap</name>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <!-- The platform's Quarkus. Moves with the platform, not ahead of it. -->
        <quarkus.platform.version>3.34.6</quarkus.platform.version>

        <!-- The terminal library. In NO BOM, so it is pinned here. 3.30.x is the current 3.x
             line. `jline-terminal`, not the aggregate `jline`: see the dependency below. -->
        <jline.version>3.30.16</jline.version>

        <!-- Not in any BOM, so it is pinned here. -->
        <assertj.version>3.27.4</assertj.version>

        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <failsafe-plugin.version>3.5.4</failsafe-plugin.version>

        <!-- Surefire's @{argLine} has no value unless something (jacoco/quarkus) sets it. -->
        <argLine/>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <!-- Command mode: picocli owns argument parsing and the subcommand tree, Quarkus owns
                 the lifecycle and configuration. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-picocli</artifactId>
        </dependency>
        <dependency>
            <!-- JSON for the ci/cd/idp/registry APIs, which are called with java.net.http. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>
        <dependency>
            <!-- The browser view's HTTP server. Command mode does not stop the server starting:
                 it serves for as long as the boot runs and goes when the process does.

                 The bare vertx-http extension, not a REST one — three routes registered on the
                 Router are the whole surface, and a JAX-RS stack would only add to the native
                 image. Off entirely with QITS_WEB=0, which stops it binding at all. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-vertx-http</artifactId>
        </dependency>
        <dependency>
            <!-- PostgreSQL over plain JDBC: the seed-postgres phase creates the deployer's role
                 and database with a handful of idempotent statements.

                 The EXTENSION rather than the bare org.postgresql:postgresql driver, because the
                 native-image metadata the driver needs (reflection on the driver class, the
                 SPI file, the SASL/SCRAM classes) is maintained by Quarkus rather than by hand
                 here. NO datasource is configured and no DataSource is injected — this CLI opens
                 its own connections with DriverManager, so nothing in the extension's runtime is
                 used beyond the driver itself.

                 Dev services are off in application.properties for the same reason: an extension
                 with no datasource would otherwise start a postgres container in test mode, and
                 `./mvnw clean verify` must need no docker. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- Only the terminal module, and only its `exec` provider.

                 The aggregate `jline` artifact carries every provider: jni, ffm, jansi and jna.
                 A native image has to analyse all of them, and two cannot be analysed on this
                 GraalVM — jni's initializer unpacks libjlinenative.so at class-init time, and the
                 ffm provider's downcall handles stop the analysis dead ("linkToNative"). The exec
                 provider needs neither: it shells /bin/stty, which a program that already shells
                 docker and git can certainly do.

                 `jline-terminal` holds the exec and dumb providers, Display and AttributedString
                 — everything this CLI uses — and ships the native-image reflection and resource
                 config the exec provider needs. Its `jline-native` dependency comes along and is
                 never called; the native profile keeps its initializer off the build. -->
            <groupId>org.jline</groupId>
            <artifactId>jline-terminal</artifactId>
            <version>${jline.version}</version>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${failsafe-plugin.version}</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- `./mvnw package -Dnative -DskipTests` builds the binary. Everything the native
                 build needs is here, so that command needs no flags of its own. It needs a
                 GraalVM on JAVA_HOME; the JDK that runs the tests does not have to be one. -->
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.native.enabled>true</quarkus.native.enabled>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>

                <!-- Empty for the binary people run on this host. The payload image's build
                     (docker/Dockerfile.bootstrap) sets it to the musl-static flags, which that
                     image needs and this host's binary must not have. Quarkus reads
                     additional-build-args from ONE config source, so an image command line naming
                     its flags whole would silently drop the jline flag below. Appending keeps that
                     flag in this file alone. An XML comment cannot hold two dashes, which is why
                     the flags are not spelled out here. -->
                <native.extra-build-args></native.extra-build-args>

                <!-- org.jline.nativ is jline-terminal's unused half: a JNI loader whose class
                     initializer unpacks libjlinenative.so into /tmp. Run at build time it fails
                     outright ("Content differs"), and this CLI's exec provider never calls it.
                     Deferring the initializer to run time is enough to keep it out of the way. -->
                <quarkus.native.additional-build-args>--initialize-at-run-time=org.jline.nativ${native.extra-build-args}</quarkus.native.additional-build-args>
            </properties>
        </profile>
    </profiles>
</project>
